<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}" Placeholder="Votre nom"/>
            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance}"/>
            <Label Text="{Binding Erreur}" FontAttributes="Italic"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Calculer" Command="{Binding CalculerCommand}"/>
                <Button Grid.Column="1" Text="Effacer" Command="{Binding EffacerCommand}"/>
            </Grid>

            <VerticalStackLayout Spacing="6" IsVisible="{Binding ResultatVisible}">
                <Label Text="{Binding Resultat}" FontSize="20"/>
                <Label Text="{Binding Message}" FontSize="18" FontAttributes="Bold"/>
                <Label Text="{Binding JoursAnniversaire}" FontSize="16"/>
            </VerticalStackLayout>

            <Label Text="Historique" FontSize="16" FontAttributes="Bold"/>
            <CollectionView ItemsSource="{Binding Historique}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" Padding="0,4"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
